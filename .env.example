# Copy to .env.local. Replace YOUR-PASSWORD with a percent-encoded password.
# Never use NEXT_PUBLIC_ for database credentials.
DATABASE_URL="postgresql://postgres.vbbmvivvqynlsshnuuyb:YOUR-PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-prod-ca-2021.crt"
# Optional: separate migration connection (direct IPv6 or session pooler IPv4).
# DIRECT_URL="postgresql://.../postgres?sslmode=verify-full"

# Generate a random secret locally; never commit the real value.
NEXTAUTH_SECRET="REPLACE-WITH-A-RANDOM-SECRET-OF-AT-LEAST-32-CHARACTERS"
NEXTAUTH_URL="http://localhost:3000"

# Password recovery email via Resend. Use an address on a verified sending domain.
RESEND_API_KEY=""
RECOVERY_EMAIL_FROM=""

# Optional, offline owner provisioning only. Fill these in .env.local.
OWNER_EMAIL=""
OWNER_PASSWORD=""
